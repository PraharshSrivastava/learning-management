# Deployment database mode:
# - VM/test bundled Postgres: set COMPOSE_PROFILES=bundled-db and use host "postgres".
# - On-prem/company Postgres: leave COMPOSE_PROFILES empty and point DATABASE_URL
#   at the company-managed database.
COMPOSE_PROFILES=bundled-db
DATABASE_URL=postgresql://lms:change_this_strong_password@postgres:5432/lms

POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_this_strong_password
LMS_POSTGRES_DATA_DIR=/opt/lms/postgres
LMS_STORAGE_DIR=/opt/lms/storage
LMS_BACKUP_DIR=/opt/lms/backups

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=3060
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=6969
EMPLOYEE_FRONTEND_PORT=6970
CORS_ALLOWED_ORIGINS=http://localhost:6969,http://localhost:6970,http://35.238.33.238:6969,http://35.238.33.238:6970

LOG_LEVEL=INFO
LLM_BASE_URL=http://35.238.33.238:4000/v1
LLM_API_KEY=replace_with_real_key
LLM_MODEL_NAME=gemma-4-e4b
LLM_CONTEXT_WINDOW=100000
LLM_MAX_INPUT_TOKENS=87000
LLM_MAX_OUTPUT_TOKENS=12000

LIBREOFFICE_EXECUTABLE=soffice
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=180

TTS_ENDPOINT=http://35.238.33.238:8081
TTS_VOICE=priyanka
TTS_TEMPERATURE=0.6
TTS_SPEED=0.9
SLIDE_TRANSITION_PAUSE_SECONDS=1.0

COURSE_THUMBNAIL_ENDPOINT=http://35.238.33.238:4000/v1/images/generations
COURSE_THUMBNAIL_MODEL=z-image-turbo
COURSE_THUMBNAIL_API_KEY=
COURSE_THUMBNAIL_CONNECT_TIMEOUT=60
COURSE_THUMBNAIL_READ_TIMEOUT=500
COURSE_THUMBNAILS_ENABLED=true

GENERATION_MAX_CONCURRENCY=1

HUB_LAUNCH_SECRET=replace_with_hub_app_launch_secret
HUB_TRAINER_APP_KEY=lms-trainer
HUB_EMPLOYEE_APP_KEY=lms-employee
HUB_TRAINER_COOKIE_NAME=lms_trainer_hub
HUB_EMPLOYEE_COOKIE_NAME=lms_employee_hub
HUB_LAUNCH_SESSION_SECONDS=28800
HUB_LAUNCH_DEV_MODE=false
HUB_COOKIE_SECURE=false

DIRECTORY_EXPORTS_BASE_URL=http://35.238.33.238:8085
DIRECTORY_EXPORTS_API_KEY=replace_with_directory_exports_api_key
DIRECTORY_SYNC_ADMIN_KEY=replace_with_internal_sync_key
DIRECTORY_SYNC_TIMEOUT_SECONDS=30
DIRECTORY_SYNC_PAGE_LIMIT=100
DIRECTORY_SYNC_ENABLED=true
DIRECTORY_SYNC_INTERVAL_HOURS=24
DIRECTORY_SYNC_INITIAL_DELAY_SECONDS=0
DIRECTORY_SYNC_TIME=09:10
DIRECTORY_SYNC_TIMEZONE=Asia/Kolkata
