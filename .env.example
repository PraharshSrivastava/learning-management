# Deployment database mode:
# - VM/test bundled Postgres: set COMPOSE_PROFILES=bundled-db and use host "postgres".
# - On-prem/company Postgres: leave COMPOSE_PROFILES empty and point DATABASE_URL
#   at the company-managed database.
COMPOSE_PROFILES=bundled-db
DATABASE_URL=postgresql://lms:change_this_strong_password@postgres:5432/lms

POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_this_strong_password
LMS_POSTGRES_DATA_DIR=/opt/lms/postgres
LMS_STORAGE_DIR=/opt/lms/storage
LMS_BACKUP_DIR=/opt/lms/backups

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=3060
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=6969
EMPLOYEE_FRONTEND_PORT=6970
CORS_ALLOWED_ORIGINS=http://localhost:6969,http://localhost:6970,http://35.238.33.238:6969,http://35.238.33.238:6970

LOG_LEVEL=INFO
LLM_BASE_URL=http://35.238.33.238:4000/v1
LLM_API_KEY=replace_with_real_key
LLM_MODEL_NAME=qwen3.6-35b
# For Qwen in LMS set false; empty preserves the provider's default.
# Sent per LMS request; does not change thinking for other projects.
LLM_ENABLE_THINKING=false
LLM_CONTEXT_WINDOW=100000
LLM_MAX_INPUT_TOKENS=87000
LLM_MAX_OUTPUT_TOKENS=12000

# Combined document workflow: keep disabled until implementation acceptance passes.
DOCUMENT_BUILDER_WORKFLOW_ENABLED=false
# Learning Journeys (Trainer Journeys tab, Employee Learning Journeys page). Keep disabled
# until the Phase 1 courses are published; when false the feature is hidden and inert.
LEARNING_JOURNEYS_ENABLED=false
# Empty uses LLM_MODEL_NAME; other generation tasks retain their existing model.
DOCUMENT_BUILDER_MODEL=
# Empty uses LLM_ENABLE_THINKING; set true/false only to override it for documents.
DOCUMENT_BUILDER_ENABLE_THINKING=
# Use json_object/json_schema only after testing the deployed proxy capability.
DOCUMENT_BUILDER_OUTPUT_MODE=json_schema
DOCUMENT_BUILDER_MODEL_TIMEOUT_SECONDS=90
DOCUMENT_BUILDER_OPERATION_DEADLINE_SECONDS=240

# Optional app-side LLM observability. Keep content capture disabled unless
# prompts and outputs have been explicitly approved for storage in Langfuse.
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
# Backward-compatible alias; LANGFUSE_BASE_URL takes precedence when both are set.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_ENVIRONMENT=uat
LANGFUSE_RELEASE=
LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_CAPTURE_MAX_CHARS=12000
LANGFUSE_TIMEOUT_SECONDS=5

LIBREOFFICE_EXECUTABLE=soffice
DOCUMENT_CONVERSION_TIMEOUT_SECONDS=180

TTS_ENDPOINT=http://35.238.33.238:8081
# Captions use a separate local forced-alignment runtime, disabled until configured.
# JSON argv list; no shell expansion. Paths must exist inside the backend runtime.
# Example: ["/home/<user>/caption-aligner/bin/python","/app/scripts/align_captions_qwen.py"]
# One run loads the model once per module: about 6 GB RAM at peak, freed when it exits.
CAPTION_ALIGN_COMMAND=[]
CAPTION_ALIGN_MODEL_PATH=
CAPTION_ALIGN_DEVICE=cpu
# Optional CPU thread count for the worker; 4 measured faster than all cores.
# CAPTION_ALIGN_THREADS=4
# Model identifier must match the configured TTS endpoint.
TTS_MODEL_NAME=Qwen/Qwen3-TTS-12Hz-1.7B-Base
TTS_VOICE=priyanka
TTS_TEMPERATURE=0.6
TTS_SPEED=0.9
SLIDE_TRANSITION_PAUSE_SECONDS=1.0

COURSE_THUMBNAIL_ENDPOINT=http://35.238.33.238:4000/v1/images/generations
COURSE_THUMBNAIL_MODEL=z-image-turbo
COURSE_THUMBNAIL_API_KEY=
COURSE_THUMBNAIL_CONNECT_TIMEOUT=60
COURSE_THUMBNAIL_READ_TIMEOUT=500
COURSE_THUMBNAILS_ENABLED=true

GENERATION_MAX_CONCURRENCY=1

# Module videos: "local" renders slides + TTS with FFmpeg; "external" uses the
# Video Generator service (/api/v1/animation-requests, HMAC-signed requests).
VIDEO_GENERATION_MODE=local
VIDEO_SERVICE_BASE_URL=
VIDEO_SERVICE_HMAC_SECRET=
VIDEO_SERVICE_MAX_CONCURRENCY=2
VIDEO_SERVICE_POLL_INTERVAL_SECONDS=20
VIDEO_SERVICE_MODULE_TIMEOUT_SECONDS=3600
VIDEO_SERVICE_REQUEST_TIMEOUT_SECONDS=60
VIDEO_SERVICE_MAX_REMOTE_RETRIES=2

HUB_LAUNCH_SECRET=replace_with_hub_app_launch_secret
HUB_TRAINER_APP_KEY=lms-trainer
HUB_EMPLOYEE_APP_KEY=lms-employee
HUB_TRAINER_COOKIE_NAME=lms_trainer_hub
HUB_EMPLOYEE_COOKIE_NAME=lms_employee_hub
HUB_LAUNCH_SESSION_SECONDS=28800
HUB_LAUNCH_DEV_MODE=false
# Root direct HTTP cookies. Set true when direct frontend origins use TLS.
HUB_COOKIE_SECURE=false
# Optional separate policy for /lms/ and /lms/trainer/. Set true for a TLS edge.
# Empty inherits HUB_COOKIE_SECURE.
HUB_SHARED_COOKIE_SECURE=
# Only this Docker edge address can supply X-Forwarded-Proto. Empty trusts none.
TRUSTED_EDGE_PROXY_IP=

DIRECTORY_EXPORTS_BASE_URL=http://35.238.33.238:8085
DIRECTORY_EXPORTS_API_KEY=replace_with_directory_exports_api_key
DIRECTORY_SYNC_ADMIN_KEY=replace_with_internal_sync_key
DIRECTORY_SYNC_TIMEOUT_SECONDS=30
DIRECTORY_SYNC_PAGE_LIMIT=100
DIRECTORY_SYNC_ENABLED=true
DIRECTORY_SYNC_INTERVAL_HOURS=24
DIRECTORY_SYNC_INITIAL_DELAY_SECONDS=0
DIRECTORY_SYNC_TIME=09:10
DIRECTORY_SYNC_TIMEZONE=Asia/Kolkata

EMAIL_DELIVERY_MODE=disabled
EMAIL_SCHEDULER_ENABLED=true
EMAIL_SCHEDULER_INTERVAL_SECONDS=300
EMAIL_WORKER_BATCH_SIZE=25
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAY_SECONDS=300
EMAIL_LOCK_TIMEOUT_SECONDS=600
EMAIL_DUE_SOON_DAYS=2
EMAIL_ASSIGNMENT_REMINDER_DAYS=5
EMAIL_OVERDUE_REPEAT_DAYS=2
EMAIL_NOTIFICATION_TIMEZONE=Asia/Kolkata
EMAIL_DIGEST_SEND_TIME=09:00
EMAIL_DUE_SOON_DIGEST_INTERVAL_HOURS=24
EMAIL_COMPLETION_DIGEST_INTERVAL_HOURS=24
EMAIL_TEST_MODE=false
EMAIL_TEST_ASSIGNMENT_REMINDER_MINUTES=5
EMAIL_TEST_DUE_SOON_WINDOW_MINUTES=7
EMAIL_TEST_OVERDUE_REPEAT_MINUTES=5
EMAIL_TEST_DIGEST_DELAY_MINUTES=1
EMAIL_SUBJECT_PREFIX=
EMAIL_RECIPIENT_ALLOWLIST=
EMAIL_FROM_EMAIL=
EMAIL_FROM_NAME=Learning Management System
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# TLS is the default; certificates are verified. For an IT-approved internal
# plaintext relay only: opt in below, use port 25, disable both TLS flags,
# and leave SMTP_USERNAME and SMTP_PASSWORD empty.
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_ALLOW_INSECURE_RELAY=false
SMTP_TIMEOUT_SECONDS=30
# General company Hub login URL for email buttons; blank omits buttons.
LMS_HUB_LOGIN_URL=
LMS_PUBLIC_URL=
LMS_EMPLOYEE_PUBLIC_URL=
LMS_TRAINER_PUBLIC_URL=
