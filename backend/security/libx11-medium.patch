 			 + sizeof(CARD16)	/* sizeof type of value */
@@ -1411,10 +1412,15 @@ _XimCountNumberOfAttr(
 	if (len > (total - min_len)) {
 	    return 0;
 	}
+	entry_size = (unsigned int)min_len + (unsigned int)len
+		   + (unsigned int)XIM_PAD(len + 2);
+
+	if (entry_size > total)
+	    return 0;
+
