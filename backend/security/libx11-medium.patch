+    buf = (CARD16 *)((char *)(buf_s + 1) + buf_s[0]);
+
+    if (remain < (2 * sizeof(CARD16)))
+	return False;
+
+    if ((size_t)buf[0] > remain - (2 * sizeof(CARD16)))
+	return False;
 
     if (!(n = _XimCountNumberOfAttr(buf[0], &buf[2], &names_len)))
