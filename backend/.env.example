# Application
APP_ENV=development
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Local storage (absolute paths are recommended outside development)
# LMS_DB_PATH=./storage/lms.db
# LMS_STORAGE_DIR=./storage
# LMS_GENERATED_DIR=./storage/generated
# LMS_UPLOAD_DIR=./storage/uploads
# LMS_IMAGE_DIR=./storage/generated/images
# LMS_AUDIO_DIR=./storage/generated/audio
# LMS_SLIDE_DIR=./storage/generated/slides
# LMS_VIDEO_DIR=./storage/generated/videos
# LMS_STATIC_DIR=./app/static
# LMS_TEMPLATE_DIR=./app/templates/slides
# LMS_PROMPTS_DIR=./app/prompts

# LLM provider
LLM_BASE_URL=http://35.238.33.238:4000/v1
LLM_MODEL_NAME=gemma-4-e4b
LLM_CONTEXT_WINDOW=8128
LLM_API_KEY=sk-test-litellm-gateway

# Text-to-speech
TTS_ENDPOINT=http://35.238.33.238:8081
TTS_VOICE=sana
TTS_TEMPERATURE=0.6
TTS_SPEED=0.9
SLIDE_TRANSITION_PAUSE_SECONDS=1.0

# Course thumbnails
COURSE_THUMBNAIL_ENDPOINT=http://35.238.33.238:4000/v1/images/generations
COURSE_THUMBNAIL_MODEL=ernie-image
# Defaults to LLM_API_KEY when omitted.
# COURSE_THUMBNAIL_API_KEY=sk-test-litellm-gateway
COURSE_THUMBNAIL_CONNECT_TIMEOUT=60
COURSE_THUMBNAIL_READ_TIMEOUT=180
COURSE_THUMBNAILS_ENABLED=true

# Long-running generation jobs. Keep this at 1 unless the host has capacity.
GENERATION_MAX_CONCURRENCY=1
